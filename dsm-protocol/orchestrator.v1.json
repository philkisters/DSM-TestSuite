    "/kill": {
      "post": {
        "summary": "Kill Peer",
        "operationId": "kill_peer_kill_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PeerIdentity"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeerResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
