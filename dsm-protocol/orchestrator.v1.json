  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JoinRequest": {
        "properties": {
          "network_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Network Id"
          },
          "peer_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Peer Id"
          },
          "bootstrap_peer_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Bootstrap Peer Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "network_id",
          "peer_id"
        ],
        "title": "JoinRequest"
      },
      "PeerIdentity": {
        "properties": {
          "network_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Network Id"
          },
          "peer_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Peer Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "network_id",
          "peer_id"
        ],
        "title": "PeerIdentity"
      },
      "PeerResponse": {
        "properties": {
          "network_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Network Id"
          },
          "peer_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Peer Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "network_id",
          "peer_id",
          "status"
        ],
        "title": "PeerResponse"
      },
      "StartRequest": {
        "properties": {
          "network_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Network Id"
          },
          "peer_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Peer Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "network_id",
          "peer_id"
        ],
        "title": "StartRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}